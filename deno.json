{
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-net --allow-run --allow-env",
    "build:web": "deno check web/src/app.ts && deno bundle --platform browser --output web/app.js web/src/app.ts",
    "bml": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env bml.ts",
    "dev": "deno task build:web && deno run --allow-read --allow-write --allow-net server/dev-server.ts"
  },
  "imports": {
    "codemirror": "npm:codemirror@^6.0.2",
    "@codemirror/state": "npm:@codemirror/state@^6.5.0",
    "@codemirror/view": "npm:@codemirror/view@^6.38.0",
    "@codemirror/language": "npm:@codemirror/language@^6.11.0",
    "@codemirror/lint": "npm:@codemirror/lint@^6.8.0",
    "@codemirror/theme-one-dark": "npm:@codemirror/theme-one-dark@^6.1.0",
    "@lezer/highlight": "npm:@lezer/highlight@^1.2.0",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "playwright": "npm:playwright@1.55.0",
    "@std/cli": "jsr:@std/cli@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  }
}
